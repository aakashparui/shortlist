# Normalise text in the repository and pin the line endings that matter.
* text=auto

# A shell script with CRLF endings fails on macOS and Linux with
# "bad interpreter: /usr/bin/env bash^M". Git Bash tolerates CRLF, so a Windows
# clone (core.autocrlf=true) runs start.sh either way and the breakage would
# only ever show up on the platforms it is hardest to test here. Pin LF.
*.sh text eol=lf

# Dockerfiles and shell snippets are read inside Linux containers.
Dockerfile* text eol=lf
*.conf text eol=lf

# PowerShell is Windows-only; CRLF is the native convention there.
*.ps1 text eol=crlf
