# Payments Transformation Simulator — configuration
#
# Copy to .env and adjust. Every value has a safe local default, so a fresh
# clone runs with no configuration at all. No secret is ever committed.

# --- persistence -------------------------------------------------------------
# SQLite is the zero-setup local default. PostgreSQL is the production target
# and is what docker compose uses.
# DATABASE_URL=sqlite+pysqlite:///./data/simulator.db
# DATABASE_URL=postgresql+psycopg://simulator:simulator@localhost:5432/simulator
DB_ECHO=false

# --- application -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json            # json for machine parsing, text for a readable console
API_V1_PREFIX=/api/v1

# --- demo and seeding --------------------------------------------------------
DEMO_MODE=true             # seed the demo book and accelerate scheme timings
AUTO_SEED=true             # seed reference data, rules and scenarios on startup
SEED_PAYMENT_COUNT=25      # minimum demo payments to create

# --- simulation timing -------------------------------------------------------
# Realistic clearing thresholds are defined per scheme (see app/schemes). In
# demo mode each scheme threshold is divided by this factor so a timeout can be
# demonstrated without waiting out a full scheme window.
SIMULATION_SPEED_FACTOR=5
CLEARING_TIMEOUT_SECONDS=25        # fallback only, for a rail with no profile
SCHEDULER_ENABLED=true             # background worker for asynchronous behaviour
SCHEDULER_POLL_INTERVAL_SECONDS=0.25

# --- api ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PAGE_SIZE=200

# --- optional AI assist ------------------------------------------------------
# The payment engine never depends on an LLM. These settings only enable
# supplementary explanation features, and AI output is always labelled.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=

# --- frontend ----------------------------------------------------------------
# The dev server proxies /api to the backend, so this is normally left unset.
# VITE_API_BASE=/api/v1
# VITE_API_PROXY=http://127.0.0.1:8000
