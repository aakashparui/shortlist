# syntax=docker/dockerfile:1

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System packages: libpq for psycopg, curl for the healthcheck.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 curl \
 && rm -rf /var/lib/apt/lists/*

# Install from pyproject.toml rather than a list repeated here, so the image
# cannot drift from the project's declared runtime dependencies.
COPY backend/ ./
RUN pip install --no-cache-dir .

# Run as an unprivileged user.
RUN useradd --create-home --uid 10001 simulator \
 && mkdir -p /app/data \
 && chown -R simulator:simulator /app
USER simulator

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

# Apply migrations, then serve. Seeding happens on startup when AUTO_SEED is on.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
