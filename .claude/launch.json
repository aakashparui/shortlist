{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shortlist-web",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "shortlist-web-standalone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "studyquest",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "studyquest",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "studyquest-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "studyquest",
        "run",
        "preview"
      ],
      "port": 5181
    },
    {
      "name": "payments-simulator-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "payments-transformation-simulator/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
